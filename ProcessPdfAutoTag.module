<?php namespace ProcessWire;

/**
 * Dashboard for PDF auto-tag requests.
 */
class ProcessPdfAutoTag extends Process implements Module {

	public static function getModuleInfo() {
		return array(
			'title' => 'PDF Auto-Tag',
			'summary' => 'PDFs in watched fields, whether auto-tag was requested, and the state of each job.',
			'version' => '0.1.1',
			'author' => 'pwstaff',
			'permission' => 'pdf-autotag',
			'permissions' => array(
				'pdf-autotag' => 'Request and review Adobe PDF auto-tagging',
			),
			'page' => array(
				'name' => 'pdf-autotag',
				'parent' => 'setup',
				'title' => 'PDF Auto-Tag',
			),
			'requires' => 'PdfAutoTag',
			'icon' => 'file-pdf-o',
		);
	}

	public function ___execute() {
		$pdf = $this->pdf();
		$sanitizer = $this->wire('sanitizer');
		$settings = $this->modules->getModuleEditUrl('PdfAutoTag', false);
		$out = '<a class="InputfieldButtonLink" href="' . $sanitizer->entities($settings) . '" tabindex="-1"><button class="ui-button ui-widget ui-corner-all pw-head-button ui-state-default" name="button" value="Module Settings" type="button"><span class="ui-button-text"><i class="fa fa-sliders"></i> Module Settings</span></button></a>';
		$out .= $this->allotmentLine($pdf);
		if($this->showRunQueue()) {
			$out .= '<form method="post" action="' . $this->page->url . 'run/">'
				. $this->csrfInputs()
				. '<button type="submit" class="uk-button uk-button-primary">Run queue now</button></form>';
		}

		$targets = $pdf->watchedTargets;
		if(!$targets || (is_array($targets) && !count($targets))) {
			$out .= '<p>No file fields are selected yet. Choose them in the module settings. Nothing is sent to Adobe until someone requests a PDF.</p>';
			return $out;
		}

		$entries = $pdf->collectPdfs();
		usort($entries, function($a, $b) {
			$aTitle = $this->ownerTitle($a);
			$bTitle = $this->ownerTitle($b);
			$cmp = strcasecmp($aTitle, $bTitle);
			if($cmp !== 0) return $cmp;
			return strcasecmp($a['filename'], $b['filename']);
		});

		$total = count($entries);
		$icon = wireIconMarkup('file-pdf-o', 'fw lg');
		$out .= '<h2>' . $icon . ' ' . $sanitizer->entities(sprintf(
			$this->_n('%d PDF in watched fields', '%d PDFs in watched fields', $total),
			$total
		)) . '</h2>';
		if(!$total) {
			$out .= '<p>None of the watched fields contain a PDF yet.</p>';
			return $out;
		}

		$out .= $this->listTable($entries)->render();
		return $out;
	}

	/**
	 * @param array $entries
	 * @return MarkupAdminDataTable
	 */
	protected function listTable(array $entries) {
		$pdf = $this->pdf();
		$sanitizer = $this->wire('sanitizer');
		/** @var MarkupAdminDataTable $table */
		$table = $this->modules->get('MarkupAdminDataTable');
		$table->setEncodeEntities(false);
		$table->setSortable(true);
		$table->setResponsive(true);
		$table->headerRow(array(
			$this->_('Page'),
			$this->_('Field'),
			$this->_('File'),
			$this->_('Requested'),
			$this->_('Status'),
			$this->_('Report'),
			$this->_('Requestor'),
			$this->_('Created'),
			$this->_('Last updated'),
			// $this->_('Source'),
			$this->_('Notes'),
			array($this->_('Actions'), 'actions'),
		));
		$table->setColNotSortable(11);

		foreach($entries as $entry) {
			$table->row(array(
				$this->pageCell($entry),
				$sanitizer->entities($pdf->locationLabel($entry)),
				$this->fileCell($entry),
				$sanitizer->entities($this->requestedLabel($entry)),
				$this->statusLabel($entry),
				$sanitizer->entities($this->reportLabel($entry)),
				$sanitizer->entities($pdf->requestorName($entry['row'])),
				$this->stamp($entry, 'created'),
				$this->stamp($entry, 'modified'),
				// $pdf->sourceChanged($entry) ? $sanitizer->entities($this->_('Changed')) : '',
				$sanitizer->entities($this->notes($entry)),
				array($this->actions($entry), 'actions'),
			));
		}
		return $table;
	}

	public function ___executeRun() {
		$this->requirePost();
		$result = $this->pdf()->executeQueue();
		if(!empty($result['locked'])) {
			$this->warning('The queue is already running.');
		} else {
			$this->message(sprintf(
				'Started %d, finished %d, failed %d. Reports removed: %d. Originals removed: %d.',
				(int) $result['started'],
				(int) $result['finished'],
				(int) $result['failed'],
				(int) $result['reportsRemoved'],
				(int) $result['backupsRemoved']
			));
			if(!empty($result['deferred'])) {
				$this->message('Some requested PDFs stayed in the queue because the monthly Adobe API call limit would not allow the next step to finish. They continue when the limit resets next month.');
			}
		}
		$this->session->redirect($this->page->url);
	}

	public function ___executeTest() {
		if($this->wire('input')->requestMethod('POST')) $this->requirePost();
		try {
			$this->message($this->pdf()->testCredentials());
		} catch(\Exception $e) {
			$this->error($e->getMessage());
		}
		$configUrl = $this->modules->getModuleEditUrl('PdfAutoTag', false);
		$back = $this->wire('input')->get('return') === 'config' ? $configUrl : $this->page->url;
		$this->session->redirect($back);
	}

	public function ___executeReprocess() {
		$this->requireAction();
		$error = $this->pdf()->reprocess($this->wire('input')->get->int('id'));
		if($error) $this->error($error);
		else $this->message('The PDF was queued again. Run the queue, or wait for the next scheduled run, to send it.');
		$this->session->redirect($this->page->url);
	}

	public function ___executeDeleteReport() {
		$this->requireAction();
		$error = $this->pdf()->deleteReport($this->wire('input')->get->int('id'));
		if($error) $this->error($error);
		else $this->message('The Excel report was deleted.');
		$this->session->redirect($this->page->url);
	}

	public function ___executeSkip() {
		$this->requireAction();
		$input = $this->wire('input')->get;
		$error = $this->pdf()->markAccessible(
			$input->int('pages_id'),
			$input->int('field_id'),
			(string) $input->subfield,
			(string) $input->filename
		);
		if($error) $this->error($error);
		else $this->message('Marked as already accessible. The editor will not offer this file for auto-tag.');
		$this->session->redirect($this->page->url);
	}

	public function ___executeUnskip() {
		$this->requireAction();
		$error = $this->pdf()->clearAccessible($this->wire('input')->get->int('id'));
		if($error) $this->error($error);
		else $this->message('The accessible mark was cleared.');
		$this->session->redirect($this->page->url);
	}

	public function ___executeReplace() {
		$this->requireAction();
		try {
			$this->pdf()->replaceFieldFile($this->wire('input')->get->int('id'), false);
			$this->message('The field file was replaced with the tagged PDF. The previous file is kept as a backup.');
		} catch(\Exception $e) {
			$this->error($e->getMessage());
		}
		$this->session->redirect($this->page->url);
	}

	public function ___executeRestore() {
		$this->requireAction();
		try {
			$this->pdf()->restoreOriginal($this->wire('input')->get->int('id'));
			$this->message('The original PDF was restored into the field.');
		} catch(\Exception $e) {
			$this->error($e->getMessage());
		}
		$this->session->redirect($this->page->url);
	}

	public function ___executeDownload() {
		$row = $this->pdf()->row($this->wire('input')->get->int('id'));
		if(!$row) throw new WireException('That record was not found.');
		$which = $this->wire('input')->get->text('file');
		if($which === 'report') {
			$path = $row['report_path'];
			$name = pathinfo($row['filename'], PATHINFO_FILENAME) . '-autotag-report.xlsx';
		} else {
			$path = $row['tagged_path'];
			$name = $row['filename'] !== '' ? $row['filename'] : 'tagged.pdf';
		}
		$name = str_replace(array('"', "\r", "\n"), '', $name);
		if(!$this->pdf()->storedFile($path)) throw new WireException('That file is not available.');
		$this->wire('files')->send($path, array(
			'forceDownload' => true,
			'downloadFilename' => $name,
			'limitPath' => false,
		));
		return '';
	}

	/**
	 * Used and allowed Adobe API calls for the current month.
	 *
	 * @param PdfAutoTag $pdf
	 * @return string
	 */
	protected function allotmentLine(PdfAutoTag $pdf) {
		$used = $pdf->monthlyCallCount();
		$limit = $pdf->monthlyCallLimit();
		$out = '<p>' . (int) $used . '/' . (int) $limit . ' Monthly Allotment of Adobe API Calls Made</p>';
		$checkCalls = $pdf->hasSavedToken() ? 1 : 2;
		$sendCalls = $pdf->hasSavedToken() ? 2 : 3;
		if(!$pdf->canSpendApiCalls($checkCalls)) {
			$out .= '<p>The monthly limit does not leave enough calls to continue a PDF. Requested files stay queued until the limit resets next month.</p>';
		} else if(!$pdf->canSpendApiCalls($sendCalls)) {
			$out .= '<p>Fewer calls remain than it takes to send another PDF. Files already sent to Adobe can still be checked. Files not yet sent stay queued until the limit resets next month.</p>';
		}
		return $out;
	}

	/**
	 * Manual queue run is for installs with no LazyCron hook and no system cron flag.
	 *
	 * @return bool
	 */
	protected function showRunQueue() {
		if($this->pdf()->systemCronEnabled()) return false;
		return !$this->modules->isInstalled('LazyCron');
	}

	protected function pdf() {
		return $this->modules->get('PdfAutoTag');
	}

	protected function requirePost() {
		if(!$this->wire('input')->requestMethod('POST')) {
			throw new WireException('Use the dashboard to run the queue.');
		}
		$this->wire('session')->CSRF->validate();
	}

	/**
	 * Accept an Actions link when it carries the current admin CSRF token.
	 *
	 * @throws WireException
	 */
	protected function requireAction() {
		if($this->wire('config')->protectCSRF === false) return;
		$session = $this->wire('session');
		$name = $session->CSRF->getTokenName();
		$sent = (string) $this->wire('input')->get($name);
		$expected = (string) $session->CSRF->getTokenValue();
		if($sent === '' || !hash_equals($expected, $sent)) {
			throw new WireException('This request was aborted because it appears to be forged.');
		}
	}

	protected function csrfInputs() {
		$session = $this->wire('session');
		$name = $session->CSRF->getTokenName();
		$value = $session->CSRF->getTokenValue();
		return '<input type="hidden" name="' . $name . '" value="' . $value . '">';
	}

	protected function ownerTitle(array $entry) {
		$owner = $this->pages->get((int) $entry['owner_pages_id']);
		if($owner && $owner->id) return (string) $owner->get('title|name');
		return 'Page #' . (int) $entry['pages_id'];
	}

	protected function pageCell(array $entry) {
		$owner = $this->pages->get((int) $entry['owner_pages_id']);
		$title = $this->wire('sanitizer')->entities($this->ownerTitle($entry));
		if($owner && $owner->id) return '<a href="' . $owner->editUrl() . '">' . $title . '</a>';
		return $title;
	}

	protected function fileCell(array $entry) {
		$name = $this->wire('sanitizer')->entities($entry['filename']);
		$extra = !empty($entry['missing']) ? '<br><span class="description">File no longer in the field</span>' : '';
		if(!empty($entry['pagefile']) && $entry['pagefile']->url) {
			$url = $this->wire('sanitizer')->entities($entry['pagefile']->url);
			return '<a href="' . $url . '" target="_blank">' . $name . '</a>' . $extra;
		}
		return $name . $extra;
	}

	protected function requestedLabel(array $entry) {
		$row = $entry['row'];
		if(!$row || $row['status'] === null) return 'No';
		return 'Yes';
	}

	protected function statusLabel(array $entry) {
		$row = $entry['row'];
		if($row && (int) $row['skipped'] === 1) return '<span title="Skipped: Already accessible"><i class="fa fa-fw fa-check-square"></i></a>';
		if(!$row || $row['status'] === null) return '<span title="Not requested"><i class="fa fw fa-minus-square-o"></i></span>';
		if($row['status'] === 0) return '<span title="Requested"><i class="fa fa-fw fa-hourglass-half"></i></span>';
		if($row['status'] === 1) return '<span title="Completed">✅</span>';
		if($row['status'] === 2) return '<span title="Failed"><i class="fa fw fa-ban"></i></span>';
		return '<span title="Not requested"><i class="fa fw fa-minus-square-o"></i></span>';
	}

	protected function reportLabel(array $entry) {
		$row = $entry['row'];
		if(!$row || $row['status'] === null) return '';
		return (int) $row['generate_report'] ? 'Yes' : 'No';
	}

	protected function stamp(array $entry, $key) {
		$row = $entry['row'];
		if(!$row || empty($row[$key])) return '';
		$ts = (int) $row[$key];
		$label = $this->wire('sanitizer')->entities($this->wire('datetime')->date('Y-m-d H:i', $ts));
		return "<span class='sort-date'>" . sprintf('%010d', $ts) . '</span>' . $label;
	}

	protected function notes(array $entry) {
		$row = $entry['row'];
		if(!$row) return '';
		$parts = array();
		if($row['error'] !== '') $parts[] = $row['error'];
		if($row['note'] !== '') $parts[] = $row['note'];
		return implode(' ', $parts);
	}

	protected function actions(array $entry) {
		$row = isset($entry['row']) ? $entry['row'] : null;
		$pdf = $this->pdf();
		$html = '';
		$id = $row ? (int) $row['id'] : 0;
		$missing = !empty($entry['missing']);
		$skipped = $row && (int) $row['skipped'] === 1;

		if($row && $pdf->storedFile($row['tagged_path'])) {
			$html .= $this->downloadLink($id, 'tagged', '<i class="fa fa-file-pdf-o" aria-hidden="true"></i>', 'Download tagged PDF');
		}
		if($row && $pdf->storedFile($row['report_path'])) {
			$html .= $this->downloadLink($id, 'report', '<i class="fa fa-list-alt" aria-hidden="true"></i>', 'Download report');
			$html .= $this->actionLink('delete-report', 'Delete Report', array('id' => $id), 'Delete the saved Excel report?', '<i class="fa fa-trash-o" aria-hidden="true"></i>');
		}
		if($row && !$skipped && !$missing && $row['status'] !== null) {
			$html .= $this->actionLink('reprocess', 'Reprocess', array('id' => $id), 'Send this PDF to Adobe again?', '<i class="fa fa-refresh" aria-hidden="true"></i>');
		}
		if(!$skipped && !$missing) {
			$html .= $this->actionLink('skip', 'Mark as already accessible', array(
				'pages_id' => (int) $entry['pages_id'],
				'field_id' => (int) $entry['field_id'],
				'subfield' => (string) $entry['subfield'],
				'filename' => (string) $entry['filename'],
			), '', '<i class="fa fa-check-square-o" aria-hidden="true"></i>');
		}
		if($skipped && $id) {
			$html .= $this->actionLink('unskip', 'Clear accessible mark', array('id' => $id), '', '<i class="fa fa-square-o" aria-hidden="true"></i>');
		}
		if($this->showReplace($entry)) {
			$html .= $this->actionLink('replace', 'Replace field file', array('id' => $id), 'Replace the field file with the tagged PDF? The current file is backed up first.', '<i class="fa fa-window-restore" aria-hidden="true"></i>');
		}
		if($row && $pdf->storedFile($row['backup_path']) && !$missing) {
			$html .= $this->actionLink('restore', 'Restore original', array('id' => $id), 'Put the backed up PDF back into the field?', '<i class="fa fa-window-restore" aria-hidden="true"></i>');
		}
		return $html;
	}

	protected function showReplace(array $entry) {
		$row = $entry['row'];
		if(!$row || !empty($entry['missing']) || empty($entry['pagefile'])) return false;
		if(!$this->pdf()->storedFile($row['tagged_path'])) return false;
		$taggedHash = @md5_file($row['tagged_path']);
		$fieldHash = @md5_file($entry['pagefile']->filename);
		if(!$taggedHash || !$fieldHash) return true;
		return !hash_equals($taggedHash, $fieldHash);
	}

	protected function downloadLink($id, $file, $label, $ariaTitle = '') {
		$url = $this->page->url . 'download/?id=' . (int) $id . '&file=' . $file;
		$title = $this->wire('sanitizer')->entities($ariaTitle !== '' ? $ariaTitle : $label);
		return '<a class="pdf-autotag-action" href="' . $url . '" title="' . $title . '" aria-label="' . $title . '">'
			. $label . '</a> ';
	}

	protected function actionLink($action, $label, array $fields, $confirm = '', $iconStr = '') {
		$session = $this->wire('session');
		$fields[$session->CSRF->getTokenName()] = $session->CSRF->getTokenValue();
		$url = $this->page->url . $action . '/?' . http_build_query($fields, '', '&', PHP_QUERY_RFC3986);
		$onclick = '';
		if($confirm !== '') {
			$onclick = ' onclick="return confirm(' . htmlspecialchars(json_encode($confirm), ENT_QUOTES, 'UTF-8') . ')"';
		}
		$title = $this->wire('sanitizer')->entities($label);
		$inner = $iconStr !== '' ? $iconStr : $title;
		return '<a class="pdf-autotag-action" href="' . $this->wire('sanitizer')->entities($url) . '"'
			. $onclick . ' title="' . $title . '" aria-label="' . $title . '">' . $inner . '</a> ';
	}
}
